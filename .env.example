# Copy to .env and fill in.

# Access token. Home Assistant and your reverse proxy send it with each request.
# Generate one with:  openssl rand -hex 24
# Leaving it empty turns the token off: only do that on a network you trust.
LABEL_BRIDGE_TOKEN=

# Port on this machine.
LABEL_BRIDGE_PORT=8091

# The printer's Bluetooth address. Leave empty to use the paired printer named "Kodak Label_…".
PRINTER_MAC=

# Time zone for log timestamps, for example Europe/London.
TZ=Etc/UTC
